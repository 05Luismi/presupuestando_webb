{
  "framework": null,
  "installCommand": "npm install --ignore-scripts",
  "buildCommand": "mkdir -p public && echo 'API de presupuestos' > public/index.html",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/pdfkit/js/data/**"
    }
  }
}
